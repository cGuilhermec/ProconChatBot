{
  "name": "procon-chatbot",
  "version": "2.0.0",
  "description": "Chatbot do Procon Jacareí com RAG, WhatsApp e IA Local",
  "main": "dist/server.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "dev:cli": "nodemon src/cli/test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:cli": "node dist/cli/test.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "node --test --import tsx src/__tests__/buscador.test.ts",
    "test:all": "node --test --import tsx src/__tests__/buscador.test.ts src/__tests__/llama.test.ts",
    "test:watch": "node --test --watch --import tsx src/__tests__/buscador.test.ts"
  },
  "keywords": [
    "procon",
    "chatbot",
    "rag",
    "whatsapp",
    "typescript"
  ],
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "natural": "^6.5.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/natural": "^5.1.1",
    "@types/node": "^20.19.39",
    "@types/qrcode-terminal": "^0.12.2",
    "nodemon": "^3.0.1",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}

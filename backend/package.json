{
  "name": "procon-rag-ts",
  "version": "1.0.0",
  "description": "RAG para Procon em TypeScript",
  "main": "dist/index.js",
  "types": "dist/types/procon.types.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "server": "node dist/server.js",
    "server-dev": "nodemon src/server.ts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "node --test --import tsx src/__tests__/buscador.test.ts",
    "test:rag": "node --test --import tsx src/__tests__/buscador.test.ts",
    "test:llama": "node --test --import tsx src/__tests__/llama.test.ts",
    "test:all": "node --test --import tsx src/__tests__/buscador.test.ts src/__tests__/llama.test.ts",
    "test:watch": "node --test --watch --import tsx src/__tests__/buscador.test.ts"
  },
  "keywords": [
    "procon",
    "rag",
    "typescript",
    "busca-semantica"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "natural": "^6.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/natural": "^5.1.1",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
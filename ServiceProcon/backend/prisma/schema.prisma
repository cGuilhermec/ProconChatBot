// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  FUNCIONARIO
  COORDENADOR
  DIRETOR
  DEV
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  COMPARECEU
  FALTOU
}

enum StatusModeracao {
  APROVADO // Disponível imediatamente
  PENDENTE_REVISAO // Aguardando análise do coordenador
  REPROVADO // Reprovado, não entra na base
  BLOQUEADO // Bloqueado por violação grave (ex: racismo explícito)
}

enum TipoNotificacao {
  PENDENTE_REVISAO // Nova pergunta aguardando revisão
  PERGUNTA_APROVADA // Pergunta foi aprovada
  PERGUNTA_REPROVADA // Pergunta foi reprovada
  PERGUNTA_BLOQUEADA // Pergunta foi bloqueada
  REVISAO_URGENTE // Palavras de alta gravidade detectadas
}

// ============================================
// TABELAS
// ============================================

model Procon {
  PROCON_ID                   Int      @id @default(autoincrement())
  nome                        String
  cidade                      String
  estado                      String
  endereco                    String
  telefone                    String
  email                       String
  horario_abertura            DateTime
  horario_fechamento          DateTime
  duracao_atendimento_minutos Int      @default(30)
  vagas_por_horario           Int      @default(2)
  ativo                       Boolean  @default(true)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  feriados     Feriado[]
  agendamentos Agendamento[]
  usuarios     Usuario[]
  perguntas    Pergunta[]

  @@index([cidade])
  @@index([estado])
  @@index([ativo])
}

model Feriado {
  FERIADO_ID Int      @id @default(autoincrement())
  procon_id  Int
  data       DateTime
  nome       String
  recorrente Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  procon Procon @relation(fields: [procon_id], references: [PROCON_ID], onDelete: Cascade)

  @@unique([procon_id, data])
  @@index([procon_id, data])
}

model Usuario {
  USUARIO_ID      Int       @id @default(autoincrement())
  nome            String
  email           String    @unique
  senha           String
  role            Role      @default(FUNCIONARIO)
  procon_id       Int?
  ativo           Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  primeiro_acesso Boolean   @default(true)
  ultimo_login    DateTime?

  procon               Procon?       @relation(fields: [procon_id], references: [PROCON_ID], onDelete: SetNull)
  perguntasCriadas     Pergunta[]    @relation("criadoPor")
  perguntasAtualizadas Pergunta[]    @relation("atualizadoPor")
  perguntasRevisadas   Pergunta[]    @relation("revisadoPor")
  auditLogs            AuditLog[]
  notificacoes         Notificacao[] 

  @@index([email])
  @@index([role])
  @@index([procon_id])
  @@map("usuario")
}

model Pergunta {
  Pergunta_ID    Int                    @id @default(autoincrement())
  procon_id      Int
  criado_por     Int
  atualizado_por Int
  tema           String
  pergunta       String
  resposta       String
  base_legal     Json?
  documentos     Json?
  observacao     String?
  embedding      Unsupported("vector")?
  ativo          Boolean                @default(true)
  versao         Int                    @default(1)

  status_moderacao    StatusModeracao @default(APROVADO)
  palavras_detectadas String[] // Array das palavras ofensivas encontradas
  revisado_por        Int? // ID do coordenador que revisou
  revisado_em         DateTime? // Quando foi revisado
  motivo_reprovacao   String? // Motivo da reprovação/bloqueio

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relacionamentos
  procon       Procon        @relation(fields: [procon_id], references: [PROCON_ID], onDelete: Cascade)
  criador      Usuario       @relation("criadoPor", fields: [criado_por], references: [USUARIO_ID])
  atualizador  Usuario       @relation("atualizadoPor", fields: [atualizado_por], references: [USUARIO_ID])
  revisador    Usuario?      @relation("revisadoPor", fields: [revisado_por], references: [USUARIO_ID])
  auditLogs    AuditLog[]
  notificacoes Notificacao[] // ⬅️ RELACIONAMENTO COM NOTIFICACOES

  @@index([procon_id, ativo])
  @@index([criado_por])
  @@index([atualizado_por])
  @@index([tema])
  @@index([status_moderacao]) // ⬅️ ÍNDICE PARA BUSCA POR STATUS
  @@map("pergunta")
}

model Agendamento {
  AGENDAMENTO_ID      Int               @id @default(autoincrement())
  procon_id           Int
  nome_usuario        String
  cpf                 String
  telefone            String
  data_agendamento    DateTime
  horario_agendamento DateTime
  status              StatusAgendamento @default(PENDENTE)
  observacao          String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  procon Procon @relation(fields: [procon_id], references: [PROCON_ID], onDelete: Cascade)

  @@index([procon_id, data_agendamento, horario_agendamento, status])
  @@index([procon_id, cpf, data_agendamento])
  @@index([status])
  @@index([data_agendamento])
}

model AuditLog {
  id               BigInt   @id @default(autoincrement())
  usuario_id       Int
  pergunta_id      Int?
  acao             String
  dados_anteriores Json?
  dados_novos      Json?
  ip_address       String?
  user_agent       String?
  created_at       DateTime @default(now())

  usuario  Usuario   @relation(fields: [usuario_id], references: [USUARIO_ID])
  pergunta Pergunta? @relation(fields: [pergunta_id], references: [Pergunta_ID], onDelete: SetNull)

  @@index([usuario_id, created_at])
  @@index([pergunta_id, created_at])
  @@index([acao])
  @@index([created_at])
}

model Notificacao {
  id                   Int             @id @default(autoincrement())
  usuario_id           Int // ID do coordenador/diretor que recebe
  pergunta_id          Int // ID da pergunta relacionada
  tipo                 TipoNotificacao @default(PENDENTE_REVISAO)
  mensagem             String // "Nova pergunta aguardando revisão"
  palavras_encontradas String[] // Palavras ofensivas detectadas
  gravidade            Int             @default(1) // 1-5 (5 = urgente)
  lida                 Boolean         @default(false)
  lida_em              DateTime? // Quando foi lida
  created_at           DateTime        @default(now())

  // Relacionamentos
  usuario  Usuario  @relation(fields: [usuario_id], references: [USUARIO_ID])
  pergunta Pergunta @relation(fields: [pergunta_id], references: [Pergunta_ID], onDelete: Cascade)

  @@index([usuario_id, lida, created_at])
  @@index([pergunta_id])
  @@index([tipo])
  @@index([gravidade])
  @@map("notificacao")
}
